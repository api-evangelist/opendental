{
  "info": {
    "name": "Open Dental API",
    "description": "REST API for Open Dental dental practice management software, hosted at Open Dental headquarters. Base URL: https://api.opendental.com/api/v1. Authenticate with an 'Authorization: ODFHIR {DeveloperKey}/{CustomerKey}' header - the Developer Key is issued by Open Dental Vendor Relations and the Customer Key is per Open Dental customer. This collection covers the endpoint-confirmed resources (Patients, Appointments, Providers, ProcedureLogs, Claims, Payments); the full published spec documents 130+ resource groups.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "value", "value": "ODFHIR {{developerKey}}/{{customerKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.opendental.com/api/v1", "type": "string" },
    { "key": "developerKey", "value": "", "type": "string" },
    { "key": "customerKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Patients",
      "item": [
        {
          "name": "Search patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/patients?LName=&FName=", "host": ["{{baseUrl}}"], "path": ["patients"], "query": [ { "key": "LName", "value": "" }, { "key": "FName", "value": "" } ] },
            "description": "Searches patients using Patient Select-style logic with many optional filters."
          }
        },
        {
          "name": "List patients (Simple)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/patients/Simple", "host": ["{{baseUrl}}"], "path": ["patients", "Simple"] },
            "description": "Fast patient listing with optional filters."
          }
        },
        {
          "name": "Get a patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/patients/:PatNum", "host": ["{{baseUrl}}"], "path": ["patients", ":PatNum"], "variable": [ { "key": "PatNum", "value": "" } ] },
            "description": "Retrieves one patient by PatNum."
          }
        },
        {
          "name": "Create a patient",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"LName\": \"Smith\",\n  \"FName\": \"Jane\"\n}" },
            "url": { "raw": "{{baseUrl}}/patients", "host": ["{{baseUrl}}"], "path": ["patients"] },
            "description": "Creates a new patient."
          }
        },
        {
          "name": "Update a patient",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/patients/:PatNum", "host": ["{{baseUrl}}"], "path": ["patients", ":PatNum"], "variable": [ { "key": "PatNum", "value": "" } ] },
            "description": "Updates an existing patient. Patients cannot be deleted via the API."
          }
        }
      ]
    },
