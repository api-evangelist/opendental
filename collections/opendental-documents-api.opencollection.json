{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open Dental Accounts & Ledger Documents API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opendental.com/api/v1/documents",
            "params": [
              {
                "name": "PatNum",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "MODELED. Files attached to a patient."
        },
        {
          "info": {
            "name": "Upload a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.opendental.com/api/v1/documents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "MODELED."
        },
        {
          "info": {
            "name": "Download a document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opendental.com/api/v1/documents/:DocNum",
            "params": [
              {
                "name": "DocNum",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "MODELED."
        }
      ]
    }
  ],
  "bundled": true
}