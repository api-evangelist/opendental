            "name": "Delete a group note procedure",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.opendental.com/api/v1/procedurelogs/:ProcNum/GroupNote",
            "params": [
              {
                "name": "ProcNum",
                "value": "",
                "type": "path",
                "description": "Primary key of the procedure log."
