          "docs": "CONFIRMED."
        },
        {
          "info": {
            "name": "Update a procedure log",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.opendental.com/api/v1/procedurelogs/:ProcNum",
