              },
              {
                "name": "AptStatus",
                "value": "",
                "type": "query"
              },
              {
                "name": "ClinicNum",
                "value": "",
                "type": "query"
              },
              {
                "name": "ProvNum",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateStart",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateEnd",
                "value": "",
                "type": "query"
              },
              {
                "name": "Offset",
                "value": "",
                "type": "query",
                "description": "Number of records to skip for pagination."
              }
            ]
          },
          "docs": "CONFIRMED. Retrieves multiple appointments with optional filters."
