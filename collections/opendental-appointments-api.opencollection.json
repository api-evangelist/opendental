                "description": "Primary key of the appointment."
              }
            ]
          },
          "docs": "CONFIRMED."
        },
        {
          "info": {
            "name": "Update an appointment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.opendental.com/api/v1/appointments/:AptNum",
